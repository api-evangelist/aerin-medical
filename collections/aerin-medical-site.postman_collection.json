      "item": [
        {
          "id": "306b558a-b92f-44a0-8305-7c52d6b862f2",
          "name": "Search across aerinmedical.com content",
          "request": {
            "name": "Search across aerinmedical.com content",
            "description": {
              "content": "Cross-content-type search. 2,242 items were indexed as observed on 2026-07-31. This is the ONLY `wp/v2` collection reachable anonymously — `posts`, `pages`, `media`, `categories`, `tags`, `users`, `comments`, `types`, `taxonomies` and `statuses` all return 401 `itsec_rest_api_access_restricted`, and the `_links.self` hrefs in each result therefore also 401. Results carry `id`, `title`, `url`, `type` and `subtype` only.\n\nAll parameters below are declared verbatim in the site's own route index.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
