          "id": "e6158d45-bb5f-4bde-9457-94fb10351497",
          "name": "Submit a doctor-finder query from the site form",
          "request": {
            "name": "Submit a doctor-finder query from the site form",
            "description": {
              "content": "Registered POST route backing the doctor-finder page. NOT INVOKED during derivation — the route index declares no arguments and the endpoint has side effects, so no request body is documented. Use `listTreatingLocations` for read access.",
