    {
      "id": "4f98d79f-5505-48e1-b79c-367bfdd20cf5",
      "name": "Locator",
      "description": {
        "content": "The Aerin doctor finder — treating ENT locations, filterable by product, designation, text and geography.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a30d1489-5925-4065-a7d8-6c5d3d6622bf",
          "name": "List ENT locations trained on Aerin procedures",
          "request": {
            "name": "List ENT locations trained on Aerin procedures",
            "description": {
              "content": "Returns the treating locations behind https://aerinmedical.com/find-ent-doctor/ — 1,012 records as observed on 2026-07-31. Each record carries the practice name, formatted address, phone, latitude/longitude, the public location permalink, and pre-rendered HTML fragments used by the site's map and result list.\n\nPagination is standard WordPress: 10 records per page by default, with the total count in the `X-WP-Total` response header and the page count in `X-WP-TotalPages`. Supplying `lat` and `lng` switches the collection into proximity mode — results are ordered by distance and each record's `distance` field becomes a number (miles) instead of `false`.\n\nThe route index declares no arguments for this route; every parameter below was confirmed by observed behaviour (differing `X-WP-Total` / ordering / `distance` values) against the live endpoint. `product` and `designation` take the WordPress term IDs exposed by the locator form at `GET /em-locator/v1/locator`.\n\nCORS is open (`Access-Control-Allow-Origin: *`) and responses are cached (`Cache-Control: max-age=600, must-revalidate`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "em-locator",
                "v1",
                "locations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page of the collection. Observed 102 pages at 10 per page."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "10",
                  "description": "Records per page."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Free-text filter over practice name / city / state. Observed to narrow `X-WP-Total` (e.g. `search=Austin` → 44)."
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "Latitude of the search origin. Supply together with `lng` to sort by proximity and populate `distance`."
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<double>",
                  "description": "Longitude of the search origin. Supply together with `lat`."
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "Filter to locations offering one product, by term ID. Observed values — `697` RhinAer (783 locations), `698` VivAer (920 locations)."
                },
                {
                  "disabled": false,
                  "key": "designation",
                  "value": "<string>",
                  "description": "Filter to Aerin Center of Excellence designations, by term ID or the `center-of-excellence` roll-up. Observed counts — any Center of Excellence 60, `699` Premier VivAer 17, `700` Advanced RhinAer 22, `701` Advanced VivAer 30, `702` Premier RhinAer 5."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6ecc4df8-b5a0-4dc4-89e1-19f61fbc783e",
              "name": "A page of treating locations. `X-WP-Total` carries the full match count; an out-of-range page returns an empty array with `X-WP-Total: 0`.",
              "originalRequest": {
                "url": {
                  "path": [
                    "em-locator",
                    "v1",
                    "locations"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "key": "per_page",
                      "value": "10"
                    },
                    {
                      "key": "search",
                      "value": "<string>"
                    },
                    {
                      "key": "lat",
                      "value": "<double>"
                    },
                    {
                      "key": "lng",
                      "value": "<double>"
                    },
                    {
                      "key": "product",
                      "value": "<string>"
                    },
                    {
                      "key": "designation",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Total records matching the query.",
                  "key": "X-WP-Total",
                  "value": "3443"
                },
                {
                  "disabled": false,
                  "description": "Total pages available.",
                  "key": "X-WP-TotalPages",
                  "value": "3443"
                },
                {
                  "disabled": false,
                  "description": "Observed as `*`.",
                  "key": "Access-Control-Allow-Origin",
                  "value": "string"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"ID\": 38,\n    \"address\": \"string\",\n    \"formatted_address\": \"string\",\n    \"lat\": \"string\",\n    \"lng\": \"string\",\n    \"distance\": false,\n    \"phone\": \"string\",\n    \"email\": \"string\",\n    \"website\": \"string\",\n    \"permalink\": \"https://B.rqv1qs3Ct-H9mZiKm8MalSsxLnpVoa.pjeWOib\",\n    \"list_item_html\": \"string\",\n    \"map_item_html\": \"string\",\n    \"map_details_html\": \"string\",\n    \"plugin_settings\": {},\n    \"post\": {\n      \"ID\": 69,\n      \"post_title\": \"string\",\n      \"post_name\": \"string\",\n      \"post_type\": \"string\",\n      \"post_status\": \"string\",\n      \"post_date\": \"string\",\n      \"post_modified\": \"string\",\n      \"post_parent\": 5289,\n      \"post_content\": \"string\"\n    }\n  },\n  {\n    \"ID\": 2027,\n    \"address\": \"string\",\n    \"formatted_address\": \"string\",\n    \"lat\": \"string\",\n    \"lng\": \"string\",\n    \"distance\": true,\n    \"phone\": \"string\",\n    \"email\": \"string\",\n    \"website\": \"string\",\n    \"permalink\": \"https://boMoRCxDPnesXh.givvTIZqMY0o+SeO6J7IsModOhnV9NdTBGFe\",\n    \"list_item_html\": \"string\",\n    \"map_item_html\": \"string\",\n    \"map_details_html\": \"string\",\n    \"plugin_settings\": {},\n    \"post\": {\n      \"ID\": 2154,\n      \"post_title\": \"string\",\n      \"post_name\": \"string\",\n      \"post_type\": \"string\",\n      \"post_status\": \"string\",\n      \"post_date\": \"string\",\n      \"post_modified\": \"string\",\n      \"post_parent\": 3631,\n      \"post_content\": \"string\"\n    }\n  }\n]",
